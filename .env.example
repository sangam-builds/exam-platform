# Root Environment Variables Template

# Backend API Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/exam_platform?schema=public"

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Auth / JWT
JWT_SECRET=dev-jwt-secret-exam-platform-2026
JWT_EXPIRES_IN=7d

# External Services (Dummy values for local dev, real secrets in Phase 10)
ANTHROPIC_API_KEY=dummy-anthropic-key-for-dev
R2_ACCOUNT_ID=dummy-r2-account
R2_ACCESS_KEY_ID=dummy-r2-access-key
R2_SECRET_ACCESS_KEY=dummy-r2-secret-key
R2_BUCKET_NAME=exam-platform-dev
RESEND_API_KEY=dummy-resend-api-key

# Frontend URLs (for CORS)
FRONTEND_STUDENT_URL=http://localhost:3000
FRONTEND_TEACHER_URL=http://localhost:3001
FRONTEND_ADMIN_URL=http://localhost:3002
