{
  "name": "exam-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:seed": "npm run seed --workspace=@exam-platform/backend",
    "db:migrate": "npm run prisma:migrate --workspace=@exam-platform/backend",
    "db:generate": "npm run prisma:generate --workspace=@exam-platform/backend",
    "test:org": "node scripts/test-organization-flow.js",
    "test:p1": "node scripts/test-phase1.js",
    "test:p2": "node scripts/test-phase2.js"
  },
  "devDependencies": {
    "turbo": "^1.12.4",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  }
}
